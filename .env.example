DB_URL=postgres://postgres:postgres@postgres:5432/app?sslmode=disable
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars_long
CORS_ORIGIN=http://localhost:3000,https://phonkersbase.com
PORT=8080

# OpenTelemetry metrics export. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to
# disable metrics export (e.g. in local dev) — instruments become no-ops.
# Grafana Cloud: endpoint is the OTLP gateway URL from your stack's
# "OpenTelemetry" page; headers carry HTTP basic auth (instance ID:API token,
# base64-encoded) as `Authorization=Basic <base64>`.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic_change_me

# Container log shipping via the Grafana Loki Docker logging driver (see
# docker-compose.prod.yaml). Requires the driver plugin installed on the host
# (pin to amd64/arm64 matching the host arch, check Docker Hub for the latest
# tag — grafana/loki-docker-driver does not publish a `:latest` tag):
#   docker plugin install grafana/loki-docker-driver:3.7.2-amd64 --alias loki --grant-all-permissions
# <user-id> and host come from the Grafana Cloud stack's Loki details page.
# Unlike OTEL_EXPORTER_OTLP_HEADERS above, these are plain text, NOT
# base64-encoded — the driver's HTTP client builds the Basic Auth header
# itself from the URL userinfo.
# URL format: https://<user-id>:<api-key>@logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_URL=https://change_me@logs-prod-XXX.grafana.net/loki/api/v1/push
